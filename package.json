{
  "name": "codex-wechat-channel",
  "version": "0.1.0",
  "description": "Bridge WeChat ClawBot messages into Codex app-server threads",
  "type": "module",
  "bin": {
    "codex-wechat-channel": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "src/",
    "scripts/",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "start": "node cli.mjs start",
    "setup": "node cli.mjs setup",
    "check": "node --check cli.mjs && node --check src/constants.mjs && node --check src/wechat-api.mjs && node --check src/codex-app-server.mjs && node --check src/setup.mjs && node --check src/start.mjs && node --check scripts/probe-app-server.mjs && node --check scripts/bridgectl.mjs",
    "probe": "node cli.mjs probe",
    "bridge:start": "node cli.mjs bridge start",
    "bridge:status": "node cli.mjs bridge status",
    "bridge:stop": "node cli.mjs bridge stop",
    "bridge:probe": "node cli.mjs probe"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "codex",
    "wechat",
    "channel",
    "app-server",
    "openai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renqingfei/codex-wechat-channel.git"
  },
  "bugs": {
    "url": "https://github.com/renqingfei/codex-wechat-channel/issues"
  },
  "homepage": "https://github.com/renqingfei/codex-wechat-channel#readme",
  "license": "MIT"
}
